# =============================================================
# Copy this file to .env and fill in your own values.
#   Windows:  copy .env.example .env
# .env is git-ignored - never commit real secrets.
# =============================================================

# --- LLM provider ---------------------------------------------
# "ollama" (free, local) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama
# Local default: install Ollama, then `ollama pull llama3.2:3b` (2 GB). On a CPU-only
# laptop answers take ~10-20 s. llama3.2:1b is faster but refused nearly every
# answerable question in our tests.
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.0

# Ollama exposes an OpenAI-compatible endpoint on this URL
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Generation limits
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=180  # local CPU models are slow
MAX_CONTEXT_CHARS=8000
# Rewrite chat follow-up questions using the last N exchanges (extra LLM call per follow-up)
REWRITE_FOLLOW_UPS=true
HISTORY_TURNS=3

# --- Embeddings -----------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking (characters) ------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ------------------------------------------------
TOP_K=5
SIMILARITY_THRESHOLD=0.30
RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Raw cross-encoder score below which chunks are dropped (initial value, tune in evaluation)
RERANK_MIN_SCORE=-6.0
# Number of first-stage candidates the reranker re-scores
RERANK_CANDIDATES=20
# First-stage similarity cutoff used instead of SIMILARITY_THRESHOLD when reranking is on
RERANK_FIRST_STAGE_MIN_SCORE=0.15
# Hybrid search (with reranking): also add the best keyword (BM25) matches, so exact
# names, codes and e-mail addresses are found. false = embeddings only.
KEYWORD_SEARCH_ENABLED=true
KEYWORD_CANDIDATES=10

# --- Storage --------------------------------------------------
DOCUMENTS_DIR=data/documents
PROCESSED_DIR=data/processed

# --- Upload limits / security ---------------------------------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# --- API / UI -------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
